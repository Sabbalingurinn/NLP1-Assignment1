{
  "source": "mteb/imdb pooled published splits",
  "seed": 42,
  "folds": 5,
  "training_size": 34707,
  "validation_size": 7437,
  "test_size": 7438,
  "metric": "macro_f1",
  "rope": 0.01,
  "bpe_vocab_limit": 2000,
  "bpe_min_pair_frequency": 2,
  "min_df": "number of training documents",
  "max_features": 100000,
  "dtype": "float32",
  "mlp_hidden_layer_sizes": [
    64
  ],
  "mlp_activation": "relu",
  "mlp_solver": "adam",
  "mlp_max_iter": 100,
  "settings": [
    {
      "name": "bpe2000_bigrams",
      "min_df": 1,
      "ngram_range": [
        2,
        2
      ]
    },
    {
      "name": "bpe2000_rare_unigrams_bigrams",
      "min_df": 2,
      "ngram_range": [
        1,
        2
      ]
    }
  ],
  "split_policy": "both tokenizer and feature vocabulary fitted only on each fold training data",
  "untouched": "separate 15% validation and 15% test; neither used in this run",
  "python": "3.14.0",
  "threads": {
    "OPENBLAS_NUM_THREADS": "2",
    "OMP_NUM_THREADS": "2"
  }
}
